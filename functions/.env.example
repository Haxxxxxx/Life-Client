# Non-secret Cloud Functions params (defineString). Copy this file to `.env` in this
# directory — Firebase reads it at deploy/emulate time.
#
# Base URL of the deployed web app; users land back here after an OAuth flow completes.
WEB_APP_URL=http://localhost:3000

# The actual OAuth client secrets (GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITLAB_CLIENT_ID,
# GITLAB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, STRAVA_CLIENT_ID,
# STRAVA_CLIENT_SECRET) are `defineSecret` params, NOT env vars — they must be set via
# `firebase functions:secrets:set <NAME>`, one at a time. See ../README.md.
