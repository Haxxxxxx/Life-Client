# Firebase project config (Firebase Console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base64-encoded service account JSON (Firebase Console -> Project settings ->
# Service accounts -> Generate new private key). Used by /api/oauth/* and
# /api/cron/sync to read/write Firestore via firebase-admin. Never commit the
# raw JSON or this value.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# OAuth app credentials — only set the ones for integrations you're using.
# Callback URL for all of them: <origin>/api/oauth/callback
# (http://localhost:3000/api/oauth/callback for local dev)
# See README.md for where to create each OAuth app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Authenticates calls to /api/cron/sync (Vercel sets this automatically in
# production; for local testing pass it yourself as a Bearer token).
CRON_SECRET=

# Web push (Profile page notifications). Generate with `npx web-push
# generate-vapid-keys` — the public key is also exposed to the client.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# The deployed Knowledge app's origin (apps/knowledge — its own separate
# Next.js app/deployment). Set once deployed so the nav can link out to it;
# leave blank to hide the link.
NEXT_PUBLIC_KNOWLEDGE_APP_URL=

# Supabase (datastore migration in progress — docs/supabase-migration-plan.md).
# `vercel integration add supabase` injects SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY; the browser client needs the NEXT_PUBLIC_ copies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Flips the Tasks feature over to the Supabase data layer once Phase 0 is validated.
NEXT_PUBLIC_DATA_BACKEND=firebase
