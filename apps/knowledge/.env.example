# Firebase project config (Firebase Console → Project settings → Your apps → Web app —
# same project, and same "Web app" config, as apps/web and apps/mobile)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base64-encoded service account JSON (Firebase Console -> Project settings ->
# Service accounts -> Generate new private key — the same service account used
# by apps/web works here too). Used by /api/knowledge/* to verify ID tokens and
# read/write Firestore via firebase-admin. Never commit the raw JSON or this
# value.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Google AI Studio (https://aistudio.google.com/apikey) — free, no credit card
# required, for the Gemini Flash/Flash-Lite models. Powers all Knowledge
# generation (daily lessons, code drills, vocabulary, reading-list summaries)
# — see src/lib/server/aiModel.ts. Note: free-tier prompts may be used by
# Google to improve their products (see AI Studio's terms).
GOOGLE_GENERATIVE_AI_API_KEY=
