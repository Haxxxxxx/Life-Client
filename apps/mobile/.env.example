# Firebase project config (Firebase Console → Project settings → Your apps → Web app —
# yes, the same "Web app" config as apps/web; the Firebase JS SDK is the same on Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration
# (the "Web client ID" — needed even on native, per @react-native-google-signin/google-signin)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cloud Functions HTTP base, e.g. https://us-central1-<project-id>.cloudfunctions.net
EXPO_PUBLIC_FUNCTIONS_BASE_URL=
