# Firebase project config (Firebase Console → Project settings → Your apps → Web app —
# yes, the same "Web app" config as apps/web; the Firebase JS SDK is the same on Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration
# (the "Web client ID" — needed even on native, per @react-native-google-signin/google-signin)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The deployed web app's origin — its /api/oauth/* routes handle the OAuth
# exchange, so mobile just needs to know where to open the system browser.
EXPO_PUBLIC_WEB_APP_URL=

# The deployed Knowledge app's origin (apps/knowledge, its own separate Next.js
# deployment) — its /api/knowledge/* routes handle AI generation.
EXPO_PUBLIC_KNOWLEDGE_APP_URL=
