rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }

      // Written only by Cloud Functions (Admin SDK bypasses these rules);
      // the client may only read its own sync state.
      match /integrations/{provider} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /sportActivities/{activityId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /devActivity/{provider} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /calendarEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Short-lived OAuth CSRF state and long-lived provider tokens.
    // Never readable/writable by clients — Cloud Functions only.
    match /oauthState/{token} {
      allow read, write: if false;
    }

    match /integrationTokens/{docId} {
      allow read, write: if false;
    }
  }
}
