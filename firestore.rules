rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }

      // Written only by the server (firebase-admin bypasses these rules);
      // the client may only read its own sync state.
      match /integrations/{provider} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Written by the server for Strava-synced entries (firebase-admin
      // bypasses these rules regardless), but also directly by the owning
      // client for manually-logged activities.
      match /sportActivities/{activityId} {
        allow read, write: if isOwner(uid);
      }

      match /challenges/{challengeId} {
        allow read, write: if isOwner(uid);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(uid);
      }

      match /devActivity/{provider} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /calendarEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /spotify/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Manual "+1 session" logs for characteristics with no integration
      // source yet (e.g. Focus, Social) — the client owns this data directly.
      match /manualProgress/{characteristicId} {
        allow read, write: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }

      // Knowledge feature: lessons/drills are generated and written entirely
      // server-side (firebase-admin bypasses these rules); the client only reads.
      match /dailyLessons/{lessonId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /codeDrills/{drillId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // The server creates each word; the client only updates its own
      // mastery state (create/delete stay server/admin-only).
      match /vocabWords/{wordId} {
        allow read, update: if isOwner(uid);
      }

      // The client adds a url and can mark it read / delete it; the server
      // fills in the summary afterwards (bypasses these rules).
      match /readingList/{itemId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Short-lived OAuth CSRF state and long-lived provider tokens.
    // Never readable/writable by clients — server (firebase-admin) only.
    match /oauthState/{token} {
      allow read, write: if false;
    }

    match /integrationTokens/{docId} {
      allow read, write: if false;
    }
  }
}
